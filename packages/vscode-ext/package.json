      "definitions": {
        "hookDefinition": {
          "type": "object",
          "properties": {
            "matcher": {
              "type": "string",
              "description": "匹配工具名称或事件的正则表达式"
            },
            "hooks": {
              "type": "array",
              "description": "要执行的 handlers",
              "items": { "$ref": "#/definitions/hookHandler" }
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "是否启用此 hook"
            },
            "description": {
              "type": "string",
              "description": "Hook 描述"
            }
          },
          "required": ["hooks"]
        },
        "hookHandler": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["command", "http", "function", "agent", "prompt"],
              "description": "Handler 类型"
            },
            "command": {
              "type": "string",
              "description": "要执行的命令（type=command 时）"
            },
            "url": {
              "type": "string",
              "description": "HTTP URL（type=http 时）"
            },
            "method": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "DELETE"],
              "default": "POST",
              "description": "HTTP 方法"
            },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "HTTP 请求头"
            },
            "handler": {
              "type": "string",
              "description": "函数名称（type=function 时）"
            },
            "timeout": {
              "type": "number",
              "default": 30000,
              "description": "超时时间（毫秒）"
            },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "环境变量（type=command 时）"
            },
            "prompt": {
              "type": "string",
              "description": "LLM 提示内容（type=agent/prompt 时）"
            },
            "model": {
              "type": "string",
              "description": "使用的模型（type=agent 时）"
            },
            "async": {
              "type": "boolean",
              "default": false,
              "description": "异步执行（不阻塞工具调用）"
            },
            "once": {
              "type": "boolean",
              "default": false,
              "description": "仅执行一次"
            },
            "statusMessage": {
              "type": "string",
              "description": "执行时显示的状态消息"
            },
            "allowedEnvVars": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "HTTP hook 允许的环境变量"
            }
          },
          "required": ["type"]
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "cclocal-settings.json",
        "url": "./cclocal-settings.schema.json"
      }
    ],
    "uriHandler": [
      {
        "path": "cclocal"
      }
    ],
    "walkthroughs": [
      {
        "id": "cclocal-walkthrough",
        "title": "Get started with CCLocal",
        "description": "Learn how to use CCLocal in VS Code",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to CCLocal",
            "description": "CCLocal helps you write, edit, and understand code right in VS Code.\n\n[Open CCLocal](command:cclocal.focus)",
            "media": {
              "image": "resources/walkthrough/welcome.png",
              "altText": "Welcome to CCLocal"
            },
            "completionEvents": ["onCommand:cclocal.focus"]
          },
          {
            "id": "open",
            "title": "Open CCLocal",
            "media": {
              "markdown": "resources/walkthrough/step2.md"
            },
            "completionEvents": ["onCommand:cclocal.focus"]
          },
          {
            "id": "chat",
            "title": "Start a conversation",
            "media": {
              "markdown": "resources/walkthrough/step3.md"
            },
            "completionEvents": ["onCommand:cclocal.focus"]
          },
          {
            "id": "sessions",
            "title": "Resume past conversations",
            "media": {
              "markdown": "resources/walkthrough/step4.md"
            },
            "completionEvents": ["onCommand:cclocal.session.list"]
          }
        ]
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Untrusted workspaces are not supported"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "build:webview": "cd webview && npm run build",
    "watch": "npm run watch:ext & npm run watch:webview",
    "watch:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "watch:webview": "cd webview && npm run dev",
    "package": "vsce package --no-dependencies --allow-star-activation",
    "package:bundle": "bun run ../../scripts/package-ext.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build:webview && npm run watch:ext",
    "clean": "rm -rf out webview-dist bundle"
  },
  "dependencies": {
    "@cclocal/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
