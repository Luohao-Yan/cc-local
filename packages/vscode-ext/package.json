{
  "name": "cclocal-vscode-ext",
  "displayName": "CCLocal - Claude Code Local",
  "description": "在 VSCode 侧边栏中使用 cclocal，支持第三方兼容 Anthropic API 的 LLM 服务",
  "version": "1.0.0",
  "publisher": "cclocal",
  "private": true,
  "type": "module",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "ai",
    "assistant",
    "cclocal",
    "llm"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:cclocalVSCodePanel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cclocal-sidebar",
          "title": "CCLocal",
          "icon": "images/icon.png",
          "visibility": "visible"
        },
        {
          "id": "cclocal-sessions-sidebar",
          "title": "CCLocal Sessions",
          "icon": "$(history)"
        }
      ],
      "secondarySidebar": [
        {
          "id": "cclocal-sidebar-secondary",
          "title": "CCLocal",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "cclocal-sidebar": [
        {
          "type": "webview",
          "id": "cclocal.chatView",
          "name": "CCLocal Chat",
          "icon": "$(comment-discussion)",
          "contextualTitle": "CCLocal"
        },
        {
          "id": "cclocal.sessions",
          "name": "Sessions",
          "icon": "$(history)",
          "contextualTitle": "CCLocal Sessions"
        }
      ],
      "cclocal-sidebar-secondary": [
        {
          "type": "webview",
          "id": "cclocal.chatViewSecondary",
          "name": "CCLocal Chat",
          "when": "!cclocal.doesNotSupportSecondarySidebar"
        }
      ],
      "cclocal-sessions-sidebar": [
        {
          "type": "webview",
          "id": "cclocal.sessionsList",
          "name": "Sessions",
          "when": "cclocal.sessionsListEnabled"
        }
      ]
    },
    "commands": [
      {
        "command": "cclocal.newSession",
        "title": "CCLocal: 新建会话",
        "icon": "$(add)"
      },
      {
        "command": "cclocal.clearChat",
        "title": "CCLocal: 清空聊天记录",
        "icon": "$(clear-all)"
      },
      {
        "command": "cclocal.stopGeneration",
        "title": "CCLocal: 停止生成",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cclocal.sendSelectedCode",
        "title": "CCLocal: 发送选中代码到 CCLocal"
      },
      {
        "command": "cclocal.openInPanel",
        "title": "CCLocal: Open in New Tab",
        "icon": "$(empty-window)"
      },
      {
        "command": "cclocal.openInSidebar",
        "title": "CCLocal: Open in Side Bar",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "cclocal.focusInput",
        "title": "CCLocal: Focus Input"
      },
      {
        "command": "cclocal.insertAtMention",
        "title": "CCLocal: Insert @-Mention Reference"
      },
      {
        "command": "cclocal.toggleDictation",
        "title": "CCLocal: Toggle Voice Dictation"
      },
      {
        "command": "cclocal.openSettings",
        "title": "CCLocal: Open Settings"
      },
      {
        "command": "cclocal.openConfigPanel",
        "title": "CCLocal: Open Configuration Panel",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cclocal.showLogs",
        "title": "CCLocal: Show Logs"
      },
      {
        "command": "cclocal.acceptEdit",
        "title": "CCLocal: Accept Proposed Changes",
        "icon": "$(check)"
      },
      {
        "command": "cclocal.rejectEdit",
        "title": "CCLocal: Reject Proposed Changes",
        "icon": "$(discard)"
      },
      {
        "command": "cclocal.login",
        "title": "CCLocal: Login",
        "icon": "$(sign-in)"
      },
      {
        "command": "cclocal.logout",
        "title": "CCLocal: Logout",
        "icon": "$(sign-out)"
      },
      {
        "command": "cclocal.checkAuth",
        "title": "CCLocal: Check Authentication Status"
      },
      {
        "command": "cclocal.switchAuthMethod",
        "title": "CCLocal: Switch Authentication Method"
      },
      {
        "command": "cclocal.configureCustomProvider",
        "title": "CCLocal: Configure Custom Provider"
      },
      {
        "command": "cclocal.setModel",
        "title": "CCLocal: Set Model"
      },
      {
        "command": "cclocal.setPermissionMode",
        "title": "CCLocal: Set Permission Mode"
      },
      {
        "command": "cclocal.hooks.enable",
        "title": "CCLocal: Enable Hooks"
      },
      {
        "command": "cclocal.hooks.disable",
        "title": "CCLocal: Disable Hooks"
      },
      {
        "command": "cclocal.hooks.clear",
        "title": "CCLocal: Clear All Hooks"
      },
      {
        "command": "cclocal.hooks.stats",
        "title": "CCLocal: Show Hook Statistics"
      },
      {
        "command": "cclocal.hooks.test",
        "title": "CCLocal: Test Hook Execution"
      },
      {
        "command": "cclocal.hooks.registerFunction",
        "title": "CCLocal: Register Function Hook"
      },
      {
        "command": "cclocal.showMCPSettings",
        "title": "CCLocal: Show MCP Server Settings",
        "icon": "$(server)"
      },
      {
        "command": "cclocal.mcp.refresh",
        "title": "CCLocal: Refresh MCP Servers",
        "icon": "$(refresh)"
      },
      {
        "command": "cclocal.mcp.reviewPending",
        "title": "CCLocal: Review Pending MCP Approvals"
      },
      {
        "command": "cclocal.mcp.listServers",
        "title": "CCLocal: List MCP Servers"
      },
      {
        "command": "cclocal.mcp.stats",
        "title": "CCLocal: Show MCP Statistics"
      },
      {
        "command": "cclocal.mcp.openUserConfig",
        "title": "CCLocal: Open User MCP Config"
      },
      {
        "command": "cclocal.mcp.openProjectConfig",
        "title": "CCLocal: Open Project MCP Config"
      },
      {
        "command": "cclocal.showPluginSettings",
        "title": "CCLocal: Show Plugin Settings",
        "icon": "$(extensions)"
      },
      {
        "command": "cclocal.installPlugin",
        "title": "CCLocal: Install Plugin",
        "icon": "$(add)"
      },
      {
        "command": "cclocal.uninstallPlugin",
        "title": "CCLocal: Uninstall Plugin"
      },
      {
        "command": "cclocal.addMarketplace",
        "title": "CCLocal: Add Plugin Marketplace"
      },
      {
        "command": "cclocal.listPlugins",
        "title": "CCLocal: List Installed Plugins"
      },
      {
        "command": "cclocal.pluginStats",
        "title": "CCLocal: Show Plugin Statistics"
      },
      {
        "command": "cclocal.switchSession",
        "title": "CCLocal: Switch to Session"
      },
      {
        "command": "cclocal.renameSession",
        "title": "CCLocal: Rename Session"
      },
      {
        "command": "cclocal.deleteSession",
        "title": "CCLocal: Delete Session"
      },
      {
        "command": "cclocal.forkSession",
        "title": "CCLocal: Fork Session"
      },
      {
        "command": "cclocal.searchSessions",
        "title": "CCLocal: Search Sessions"
      },
      {
        "command": "cclocal.clearSessionSearch",
        "title": "CCLocal: Clear Session Search"
      },
      {
        "command": "cclocal.generateSessionTitle",
        "title": "CCLocal: Generate Session Title"
      },
      {
        "command": "cclocal.sessionStats",
        "title": "CCLocal: Show Session Statistics"
      },
      {
        "command": "cclocal.sendMessage",
        "title": "CCLocal: Send Message"
      },
      {
        "command": "cclocal.showRemotePanel",
        "title": "CCLocal: Show Remote Panel",
        "icon": "$(remote)"
      },
      {
        "command": "cclocal.remote.addConfig",
        "title": "CCLocal: Add Remote SSH Configuration",
        "icon": "$(add)"
      },
      {
        "command": "cclocal.remote.connect",
        "title": "CCLocal: Connect to Remote Server",
        "icon": "$(plug)"
      },
      {
        "command": "cclocal.remote.disconnect",
        "title": "CCLocal: Disconnect from Remote Server",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "cclocal.remote.teleport",
        "title": "CCLocal: Teleport Session to Remote",
        "icon": "$(broadcast)"
      },
      {
        "command": "cclocal.remote.stats",
        "title": "CCLocal: Show Remote Connection Statistics"
      },
      {
        "command": "cclocal.remote.execute",
        "title": "CCLocal: Execute Command on Remote"
      },
      {
        "command": "cclocal.remote.checkVSCode",
        "title": "CCLocal: Check VS Code Remote Environment"
      },
      {
        "command": "cclocal.newChannel",
        "title": "CCLocal: New Conversation Tab",
        "icon": "$(add)"
      },
      {
        "command": "cclocal.closeChannel",
        "title": "CCLocal: Close Conversation Tab"
      },
      {
        "command": "cclocal.switchChannel",
        "title": "CCLocal: Switch Conversation Tab"
      },
      {
        "command": "cclocal.renameChannel",
        "title": "CCLocal: Rename Conversation Tab"
      },
      {
        "command": "cclocal.acceptProposedDiff",
        "title": "CCLocal: Accept Proposed Changes",
        "icon": "$(check)"
      },
      {
        "command": "cclocal.rejectProposedDiff",
        "title": "CCLocal: Reject Proposed Changes",
        "icon": "$(discard)"
      },
      {
        "command": "cclocal.focus",
        "title": "CCLocal: Focus Chat",
        "icon": "$(symbol-color)"
      },
      {
        "command": "cclocal.blur",
        "title": "CCLocal: Blur Chat"
      },
      {
        "command": "cclocal.editor.open",
        "title": "CCLocal: Open in Editor Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "cclocal.editor.openLast",
        "title": "CCLocal: Open Last Conversation",
        "icon": "$(history)"
      },
      {
        "command": "cclocal.createWorktree",
        "title": "CCLocal: Create Worktree",
        "icon": "$(git-branch)"
      },
      {
        "command": "cclocal.terminal.open",
        "title": "CCLocal: Open in Terminal"
      },
      {
        "command": "cclocal.terminal.open.keyboard",
        "title": "CCLocal: Open Terminal (Keyboard Mode)"
      },
      {
        "command": "cclocal.openWalkthrough",
        "title": "CCLocal: Open Getting Started"
      },
      {
        "command": "cclocal.window.open",
        "title": "CCLocal: Open in New Window"
      },
      {
        "command": "cclocal.primaryEditor.open",
        "title": "CCLocal: Open as Primary Editor",
        "enablement": "cclocal.primaryEditorEnabled"
      },
      {
        "command": "cclocal.chat.new",
        "title": "CCLocal: New Conversation"
      },
      {
        "command": "cclocal.mcp.ensureChromeEnabled",
        "title": "CCLocal: Enable Chrome MCP"
      },
      {
        "command": "cclocal.mcp.disableChrome",
        "title": "CCLocal: Disable Chrome MCP"
      },
      {
        "command": "cclocal.mcp.enableJupyter",
        "title": "CCLocal: Enable Jupyter MCP"
      },
      {
        "command": "cclocal.mcp.disableJupyter",
        "title": "CCLocal: Disable Jupyter MCP"
      },
      {
        "command": "cclocal.update",
        "title": "CCLocal: Check for Updates"
      },
      {
        "command": "cclocal.installPlugin",
        "title": "CCLocal: Install Plugin"
      },
      {
        "command": "cclocal.addComment",
        "title": "CCLocal: Add Comment"
      },
      {
        "command": "cclocal.removeComment",
        "title": "CCLocal: Remove Comment"
      },
      {
        "command": "cclocal.acceptPlan",
        "title": "CCLocal: Accept Plan"
      },
      {
        "command": "cclocal.rejectPlan",
        "title": "CCLocal: Reject Plan"
      },
      {
        "command": "cclocal.closePlanPreview",
        "title": "CCLocal: Close Plan Preview"
      },
      {
        "command": "cclocal.dismissTerminalBanner",
        "title": "CCLocal: Dismiss Terminal Banner"
      },
      {
        "command": "cclocal.dismissReviewUpsellBanner",
        "title": "CCLocal: Dismiss Review Upsell"
      },
      {
        "command": "cclocal.setProactive",
        "title": "CCLocal: Toggle Proactive Suggestions"
      },
      {
        "command": "cclocal.createNewBrowserTab",
        "title": "CCLocal: Create Browser Tab"
      },
      {
        "command": "cclocal.showLogs",
        "title": "CCLocal: Show Logs",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cclocal.newSession",
          "when": "view == cclocal.chatView",
          "group": "navigation@1"
        },
        {
          "command": "cclocal.clearChat",
          "when": "view == cclocal.chatView",
          "group": "navigation@2"
        },
        {
          "command": "cclocal.openInPanel",
          "when": "view == cclocal.chatView",
          "group": "navigation@3"
        },
        {
          "command": "cclocal.newConversation",
          "when": "view == cclocal.sessions",
          "group": "navigation@1"
        },
        {
          "command": "cclocal.searchSessions",
          "when": "view == cclocal.sessions",
          "group": "navigation@2"
        },
        {
          "command": "cclocal.clearSessionSearch",
          "when": "view == cclocal.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "cclocal.renameSession",
          "when": "view == cclocal.sessions && viewItem =~ /session/",
          "group": "1_modify@1"
        },
        {
          "command": "cclocal.forkSession",
          "when": "view == cclocal.sessions && viewItem =~ /session/",
          "group": "1_modify@2"
        },
        {
          "command": "cclocal.generateSessionTitle",
          "when": "view == cclocal.sessions && viewItem =~ /session/",
          "group": "1_modify@3"
        },
        {
          "command": "cclocal.deleteSession",
          "when": "view == cclocal.sessions && viewItem =~ /session/",
          "group": "2_danger@1"
        }
      ],
      "editor/title": [
        {
          "command": "cclocal.acceptEdit",
          "when": "cclocal.viewingProposedDiff",
          "group": "navigation@1"
        },
        {
          "command": "cclocal.rejectEdit",
          "when": "cclocal.viewingProposedDiff",
          "group": "navigation@2"
        },
        {
          "command": "cclocal.acceptProposedDiff",
          "when": "cclocal.viewingProposedDiff",
          "group": "navigation@3"
        },
        {
          "command": "cclocal.rejectProposedDiff",
          "when": "cclocal.viewingProposedDiff",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "cclocal.sendSelectedCode",
          "when": "editorHasSelection",
          "group": "cclocal"
        }
      ],
      "commandPalette": [
        {
          "command": "cclocal.insertAtMention",
          "when": "editorTextFocus"
        },
        {
          "command": "cclocal.acceptEdit",
          "when": "cclocal.viewingProposedDiff"
        },
        {
          "command": "cclocal.rejectEdit",
          "when": "cclocal.viewingProposedDiff"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cclocal.edit.insertAtMention",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "cclocal.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape",
        "when": "editorFocus"
      },
      {
        "command": "cclocal.blur",
        "key": "ctrl+escape",
        "mac": "cmd+escape",
        "when": "cclocal.sideBarActive && !editorFocus"
      },
      {
        "command": "cclocal.terminal.open.keyboard",
        "key": "ctrl+escape",
        "mac": "cmd+escape",
        "when": "config.cclocal.useTerminal"
      },
      {
        "command": "cclocal.editor.open",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "cclocal.chat.new",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "cclocal.enableNewConversationShortcut && cclocal.sideBarActive"
      }
    ],
    "configuration": {
      "title": "CCLocal",
      "properties": {
        "cclocal.mode": {
          "type": "string",
          "default": "ide",
          "enum": ["ide", "cli", "websocket"],
          "enumDescriptions": [
            "IDE 模式（推荐）：CLI 连接到扩展的 WebSocket 服务器",
            "CLI 模式：每次对话启动新进程",
            "WebSocket 模式：连接到外部 CCLocal 服务器"
          ],
          "description": "CCLocal 通信模式"
        },
        "cclocal.forceLoginMethod": {
          "type": "string",
          "default": "",
          "enum": ["", "claudeai", "console", "bedrock", "vertex", "custom"],
          "enumDescriptions": [
            "自动检测",
            "Claude.ai OAuth（订阅用户）",
            "API Key（控制台）",
            "AWS Bedrock",
            "Google Vertex AI",
            "第三方 API"
          ],
          "description": "强制使用指定的登录方式"
        },
        "cclocal.forceLoginOrgUUID": {
          "type": "string",
          "default": "",
          "description": "OAuth 组织 UUID（可选）"
        },
        "cclocal.disableLoginPrompt": {
          "type": "boolean",
          "default": false,
          "description": "禁用登录提示"
        },
        "cclocal.environmentVariables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          },
          "default": [],
          "description": "传递给 cclocal 进程的环境变量"
        },
        "cclocal.cclocalPath": {
          "type": "string",
          "default": "cclocal",
          "description": "cclocal 可执行文件的绝对路径"
        },
        "cclocal.claudeProcessWrapper": {
          "type": "string",
          "default": "",
          "description": "cclocal 进程包装命令"
        },
        "cclocal.initialPermissionMode": {
          "type": "string",
          "default": "default",
          "enum": ["default", "acceptEdits", "plan", "bypassPermissions"],
          "enumDescriptions": [
            "默认模式：危险操作需确认",
            "自动接受文件编辑，命令需确认",
            "计划模式：不执行任何操作",
            "自动接受所有操作（危险）"
          ],
          "description": "初始权限模式"
        },
        "cclocal.allowDangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "description": "允许危险地跳过所有权限检查"
        },
        "cclocal.permissionRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": { "type": "string" },
              "behavior": { "type": "string", "enum": ["allow", "deny", "ask"] }
            }
          },
          "default": [],
          "description": "自定义权限规则"
        },
        "cclocal.respectGitIgnore": {
          "type": "boolean",
          "default": true,
          "description": "文件选择器是否遵循 .gitignore"
        },
        "cclocal.fileSuggestion": {
          "type": "object",
          "properties": {
            "maxResults": { "type": "number" },
            "includePatterns": { "type": "array", "items": { "type": "string" } },
            "excludePatterns": { "type": "array", "items": { "type": "string" } }
          },
          "description": "@ 引用的文件建议配置"
        },
        "cclocal.autosave": {
          "type": "boolean",
          "default": false,
          "description": "编辑文件前自动保存"
        },
        "cclocal.claudeMdExcludes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "要排除的 CLAUDE.md 文件模式"
        },
        "cclocal.enableAllProjectMcpServers": {
          "type": "boolean",
          "default": false,
          "description": "启用所有项目级 MCP 服务器"
        },
        "cclocal.approvedMcpServers": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "已批准的 MCP 服务器列表"
        },
        "cclocal.allowedMcpServers": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "允许的 MCP 服务器白名单"
        },
        "cclocal.deniedMcpServers": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "拒绝的 MCP 服务器黑名单"
        },
        "cclocal.disableAllHooks": {
          "type": "boolean",
          "default": false,
          "description": "禁用所有 hooks"
        },
        "cclocal.allowedHttpHookUrls": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "允许的 HTTP hook URL 白名单"
        },
        "cclocal.httpHookAllowedEnvVars": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "HTTP hooks 中允许的环境变量"
        },
        "cclocal.allowedCommands": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "允许的命令 hook 白名单"
        },
        "cclocal.allowedEnvVars": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "允许传递给 hooks 的环境变量"
        },
        "cclocal.hooks": {
          "type": "object",
          "description": "Hook 配置（按类型）",
          "properties": {
            "PreToolUse": {
              "type": "array",
              "description": "工具执行前的 hooks",
              "items": { "$ref": "#/definitions/hookDefinition" }
            },
            "PostToolUse": {
              "type": "array",
              "description": "工具执行后的 hooks",
              "items": { "$ref": "#/definitions/hookDefinition" }
            },
            "SessionStart": {
              "type": "array",
              "description": "会话开始的 hooks",
              "items": { "$ref": "#/definitions/hookDefinition" }
            },
            "SessionEnd": {
              "type": "array",
              "description": "会话结束的 hooks",
              "items": { "$ref": "#/definitions/hookDefinition" }
            },
            "FileWrite": {
              "type": "array",
              "description": "文件写入的 hooks",
              "items": { "$ref": "#/definitions/hookDefinition" }
            },
            "FileEdit": {
              "type": "array",
              "description": "文件编辑的 hooks",
              "items": { "$ref": "#/definitions/hookDefinition" }
            },
            "BashExecution": {
              "type": "array",
